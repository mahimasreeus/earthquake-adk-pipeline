<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Earthquake Activity Report</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>
  :root {
    color-scheme: light;
    --surface-0: #f4f3f0; --surface-1: #fcfcfb; --border: #e2e1dc;
    --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #7a7974;
    --grid: #e9e8e4; --series-1: #2a78d6; --series-2: #eb6834; --series-3: #1baf7a;
    --good: #0ca30c; --warning: #b57d00; --critical: #d03b3b;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --surface-0: #111110; --surface-1: #1a1a19; --border: #2e2e2c;
      --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #8f8e88;
      --grid: #2a2a28; --series-1: #3987e5; --series-2: #d95926; --series-3: #199e70;
      --warning: #fab219;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --surface-0: #111110; --surface-1: #1a1a19; --border: #2e2e2c;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #8f8e88;
    --grid: #2a2a28; --series-1: #3987e5; --series-2: #d95926; --series-3: #199e70;
    --warning: #fab219;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--surface-0); color: var(--text-primary);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 24px 16px 48px; }
  header h1 { margin: 0 0 4px; font-size: 26px; letter-spacing: -0.01em; }
  header p { margin: 0; color: var(--text-secondary); }
  h2 { font-size: 17px; margin: 0 0 4px; }
  .sub { color: var(--text-muted); font-size: 13px; margin: 0 0 12px; }
  .card { background: var(--surface-1); border: 1px solid var(--border);
          border-radius: 10px; padding: 18px; min-width: 0; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
          gap: 12px; margin: 20px 0; }
  .kpi .label { color: var(--text-secondary); font-size: 13px; }
  .kpi .value { font-size: 28px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .kpi .detail { color: var(--text-muted); font-size: 12.5px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
  .full { grid-column: 1 / -1; }
  @media (max-width: 800px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .chart { position: relative; height: 300px; }
  .chart.tall { height: 420px; }
  #map { height: 420px; border-radius: 8px; }
  .summary { border-left: 4px solid var(--series-1); font-size: 15.5px; margin-bottom: 16px; }
  .summary p { margin: 0; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); }
  th { color: var(--text-secondary); font-weight: 600; white-space: nowrap; }
  td.num, th.num { text-align: right; }
  a { color: var(--series-1); }
  .heat th.num, .heat td.num { text-align: center; }
  .heat td.cell { text-align: center; font-weight: 600; border: 2px solid var(--surface-1); border-radius: 4px; }
  .heat td.cell.dark { color: #0b0b0b; } .heat td.cell.light { color: #ffffff; }
  .heat td.cell.empty { color: var(--text-muted); font-weight: 400; }
  .legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 13px; color: var(--text-secondary); margin-top: 8px; }
  .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 600; font-size: 13px; border: 1px solid currentColor; }
  .badge.pass { color: var(--good); } .badge.warn { color: var(--warning); } .badge.fail { color: var(--critical); }
  .lineage dt { color: var(--text-secondary); font-size: 13px; margin-top: 10px; }
  .lineage dd { margin: 2px 0 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; word-break: break-all; }
  footer { color: var(--text-muted); font-size: 12.5px; margin-top: 24px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Global Earthquake Activity</h1>
    <p>USGS events from {{ run.start }} to {{ run.end }} (end exclusive), magnitude &ge; {{ run.min_magnitude }}
       &middot; run <code>{{ run.run_id }}</code></p>
  </header>

  {% set k = kpis %}
  <section class="kpis">
    <div class="card kpi"><div class="label">Total events</div>
      <div class="value">{{ "{:,}".format(k.total_events) }}</div>
      <div class="detail">avg magnitude {{ k.avg_magnitude }}</div></div>
    <div class="card kpi"><div class="label">Strongest quake</div>
      <div class="value">M{{ k.strongest_event.magnitude }}</div>
      <div class="detail">{{ k.strongest_event.place }} &middot; {{ k.strongest_event.time }}</div></div>
    <div class="card kpi"><div class="label">Shallow events (&lt;70 km)</div>
      <div class="value">{{ k.pct_shallow }}%</div>
      <div class="detail">{{ k.events_m5_plus }} events were M5.0+</div></div>
    <div class="card kpi"><div class="label">Tsunami-flagged</div>
      <div class="value">{{ k.tsunami_flagged }}</div>
      <div class="detail">{{ k.orange_or_red_alerts }} orange/red PAGER alerts</div></div>
    <div class="card kpi"><div class="label">Busiest day</div>
      <div class="value">{{ k.busiest_day.event_count }}</div>
      <div class="detail">events on {{ k.busiest_day.date }}</div></div>
  </section>

  <section class="card summary">
    <h2>Agent summary</h2>
    <p class="sub">Written by the ReportingAgent (Gemini) from this run's KPIs and aggregates.</p>
    <p>{{ summary_text }}</p>
  </section>

  <div class="grid">
    <section class="card full">
      <h2>Events per day</h2>
      <p class="sub">Daily count (UTC). Hover a bar for that day's mean and max magnitude. The last day may be partial.</p>
      <div class="chart"><canvas id="dailyChart" aria-label="Bar chart of events per day"></canvas></div>
    </section>

    <section class="card">
      <h2>Top regions by event count</h2>
      <p class="sub">Region parsed from the USGS place string; hover for magnitude and depth.</p>
      <div class="chart tall"><canvas id="regionChart" aria-label="Bar chart of top regions"></canvas></div>
    </section>

    <section class="card">
      <h2>Magnitude vs depth</h2>
      <p class="sub">Each dot is one event; depth increases downward.</p>
      <div class="chart tall"><canvas id="scatterChart" aria-label="Scatter plot of magnitude versus depth"></canvas></div>
    </section>

    <section class="card full">
      <h2>Magnitude band &times; depth class</h2>
      <p class="sub">Event counts; darker cells hold more events.</p>
      <div class="table-wrap">
        <table class="heat">
          <thead><tr><th>Magnitude band</th>{% for c in heatmap.columns %}<th class="num">{{ c }}</th>{% endfor %}<th class="num">Total</th></tr></thead>
          <tbody>
          {% for row in heatmap.rows %}
            <tr><th>{{ row.band }}</th>
              {% for cell in row.cells %}<td class="cell {{ 'empty' if cell.empty else ('dark' if cell.dark_text else 'light') }}"
                  style="background: {{ 'transparent' if cell.empty else cell.bg }}"
                  title="{{ row.band }}, {{ cell.depth }}: {{ cell.count }} events">{{ "{:,}".format(cell.count) }}</td>{% endfor %}
              <td class="num"><strong>{{ "{:,}".format(row.total) }}</strong></td></tr>
          {% endfor %}
            <tr><th>Total</th>{% for t in heatmap.column_totals %}<td class="num"><strong>{{ "{:,}".format(t) }}</strong></td>{% endfor %}<td></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card full">
      <h2>Where they happened</h2>
      <p class="sub">Circle size scales with magnitude; color shows depth class.
        {% if points_truncated %}Showing the {{ points|length }} strongest events.{% endif %}</p>
      <div id="map" role="img" aria-label="Map of earthquake locations"></div>
      <div class="legend">
        <span><span class="swatch" style="background: var(--series-1)"></span>Shallow (&lt;70 km)</span>
        <span><span class="swatch" style="background: var(--series-2)"></span>Intermediate (70&ndash;300 km)</span>
        <span><span class="swatch" style="background: var(--series-3)"></span>Deep (&gt;300 km)</span>
      </div>
    </section>

    <section class="card full">
      <h2>Top 10 strongest events</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Time (UTC)</th><th class="num">Mag</th><th>Place</th><th>Region</th>
                     <th class="num">Depth km</th><th>Tsunami</th><th>Alert</th></tr></thead>
          <tbody>
          {% for e in top_events %}
            <tr><td>{{ e.time }}</td><td class="num"><strong>{{ e.magnitude }}</strong> <span style="color:var(--text-muted)">{{ e.mag_type or '' }}</span></td>
              <td>{% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.place }}</a>{% else %}{{ e.place }}{% endif %}</td>
              <td>{{ e.region }}</td><td class="num">{{ "%.1f"|format(e.depth_km) }}</td>
              <td>{{ 'Yes' if e.tsunami else 'No' }}</td><td>{{ e.alert or '—' }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="card full">
      <h2>Data quality &amp; lineage</h2>
      <p class="sub">Checks run by the ProcessingAgent before anything was published.
        Status: <span class="badge {{ quality.status }}">{{ quality.status|upper }}</span></p>
      <div class="grid" style="margin:0">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Step</th><th class="num">Rows before</th><th class="num">Rows after</th><th class="num">Removed</th></tr></thead>
            <tbody>
              <tr><td>Raw events from USGS</td><td class="num"></td><td class="num">{{ "{:,}".format(quality.raw_rows) }}</td><td></td></tr>
              {% for s in quality.steps %}
              <tr><td>{{ s.step|replace('_', ' ') }}</td><td class="num">{{ "{:,}".format(s.rows_before) }}</td>
                  <td class="num">{{ "{:,}".format(s.rows_after) }}</td><td class="num">{{ "{:,}".format(s.rows_removed) }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
          <p class="sub" style="margin-top:10px">
            Magnitude range {{ quality.magnitude_range[0] }} – {{ quality.magnitude_range[1] }} &middot;
            depth range {{ "%.1f"|format(quality.depth_range_km[0]) }} – {{ "%.1f"|format(quality.depth_range_km[1]) }} km.
            {% if quality.issues %}<br>Issues: {{ quality.issues|join('; ') }}{% else %}<br>No issues found.{% endif %}
          </p>
        </div>
        <dl class="lineage">
          <dt>Run ID / generated</dt><dd>{{ run.run_id }} &middot; {{ run.generated_at }}</dd>
          <dt>Data source</dt><dd><a href="{{ run.source_url }}" target="_blank" rel="noopener">{{ run.source_url }}</a></dd>
          <dt>Storage backend</dt><dd>{{ run.backend }}</dd>
          <dt>Raw</dt>{% for u in uris.raw %}<dd>{{ u }}</dd>{% else %}<dd>—</dd>{% endfor %}
          <dt>Processed</dt>{% for u in uris.processed %}<dd>{{ u }}</dd>{% else %}<dd>—</dd>{% endfor %}
          <dt>Report</dt>{% for u in uris.report %}<dd>{{ u }}</dd>{% endfor %}
        </dl>
      </div>
    </section>
  </div>

  <footer>Generated by an agentic pipeline built with Google ADK &middot; data: U.S. Geological Survey Earthquake Hazards Program.</footer>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
  const DAILY = {{ daily|tojson }};
  const REGIONS = {{ regions|tojson }};
  const POINTS = {{ points|tojson }};

  const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const C = { s1: css('--series-1'), s2: css('--series-2'), s3: css('--series-3'),
              text: css('--text-secondary'), grid: css('--grid'), surface: css('--surface-1') };
  Chart.defaults.color = C.text;
  Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
  Chart.defaults.plugins.legend.display = false;   // single-series charts: the title names the series
  const axis = (title, extra = {}) => ({ grid: { color: C.grid }, border: { display: false },
                                         title: { display: !!title, text: title }, ...extra });
  const fmt = v => (v === null || v === undefined) ? '—' : v;

  if (typeof Chart !== 'undefined') {
    new Chart(document.getElementById('dailyChart'), {
      type: 'bar',
      data: { labels: DAILY.map(d => d.date),
              datasets: [{ label: 'Events', data: DAILY.map(d => d.event_count),
                           backgroundColor: C.s1, borderRadius: 4, borderSkipped: 'start',
                           maxBarThickness: 28 }] },
      options: { maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        scales: { x: axis('', { grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 12 } }),
                  y: axis('Events', { beginAtZero: true }) },
        plugins: { tooltip: { callbacks: { afterLabel: ctx => {
          const d = DAILY[ctx.dataIndex];
          return [`Mean magnitude: ${fmt(d.mean_magnitude)}`, `Max magnitude: ${fmt(d.max_magnitude)}`]; } } } } }
    });

    new Chart(document.getElementById('regionChart'), {
      type: 'bar',
      data: { labels: REGIONS.map(r => r.region),
              datasets: [{ label: 'Events', data: REGIONS.map(r => r.event_count),
                           backgroundColor: C.s1, borderRadius: 4, borderSkipped: 'start', maxBarThickness: 22 }] },
      options: { indexAxis: 'y', maintainAspectRatio: false,
        scales: { x: axis('Events', { beginAtZero: true }), y: axis('', { grid: { display: false } }) },
        plugins: { tooltip: { callbacks: { afterLabel: ctx => {
          const r = REGIONS[ctx.dataIndex];
          return [`Avg magnitude: ${r.avg_magnitude}`, `Max magnitude: ${r.max_magnitude}`, `Avg depth: ${r.avg_depth_km} km`]; } } } } }
    });

    new Chart(document.getElementById('scatterChart'), {
      type: 'scatter',
      data: { datasets: [{ label: 'Events', data: POINTS.map(p => ({ x: p.magnitude, y: p.depth_km, place: p.place })),
                           backgroundColor: C.s1 + '99', borderColor: C.surface, borderWidth: 1,
                           pointRadius: 4, pointHoverRadius: 7 }] },
      options: { maintainAspectRatio: false,
        scales: { x: axis('Magnitude'), y: axis('Depth (km)', { reverse: true,
                  min: Math.min(0, Math.floor(Math.min(...POINTS.map(p => p.depth_km)) / 10) * 10) }) },
        plugins: { tooltip: { callbacks: { label: ctx =>
          `M${ctx.raw.x} at ${ctx.raw.y} km — ${ctx.raw.place || 'unknown place'}` } } } }
    });
  }

  if (typeof L !== 'undefined') {
    const map = L.map('map', { worldCopyJump: true }).setView([15, 0], 2);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
                { maxZoom: 8, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
    const depthColor = d => d < 70 ? C.s1 : (d < 300 ? C.s2 : C.s3);
    // Draw small events first so large ones sit on top.
    [...POINTS].reverse().forEach(p => {
      L.circleMarker([p.latitude, p.longitude], {
        radius: Math.max(3, (p.magnitude - 1.5) * 2.6), color: C.surface, weight: 1,
        fillColor: depthColor(p.depth_km), fillOpacity: 0.7
      }).bindTooltip(`<strong>M${p.magnitude}</strong> ${p.place || ''}<br>${p.depth_km} km deep · ${p.time.slice(0, 16)} UTC`)
        .addTo(map);
    });
  }
</script>
</body>
</html>
