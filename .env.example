# Copy this file to .env and fill in your values:   cp .env.example .env
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# LLM (Gemini) — option A (default): Google AI Studio API key
# Get one free at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key-here

# LLM — option B: Vertex AI (uncomment, set VERTEXAI=TRUE, and run
# `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model used by every agent. Flash-Lite is fast, cheap, and has a much
# larger free-tier daily quota than Flash (free-tier Flash allows ~20 requests
# per day, and one pipeline run uses ~12). Use gemini-3.5-flash if you have
# billing enabled and want slightly richer summaries.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Pipeline defaults (can be overridden with CLI flags in main.py)
# ---------------------------------------------------------------------------
PIPELINE_DAYS=30
PIPELINE_MIN_MAGNITUDE=2.5

# ---------------------------------------------------------------------------
# Storage backend: local | gcs | s3
#   local -> writes to ./output/storage/ (no cloud account needed)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local

# Google Cloud Storage (STORAGE_BACKEND=gcs)
# Auth: `gcloud auth application-default login`, OR set the key path below
# to a service-account JSON stored OUTSIDE this repo.
GCS_BUCKET=your-gcs-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/sa-key.json

# AWS S3 (STORAGE_BACKEND=s3)
# Auth: `aws configure` (~/.aws/credentials) or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# Local working/output directory (defaults to ./output)
# OUTPUT_DIR=./output
